# Sao chép thành BE/.env rồi điền giá trị thật:  cp BE/.env.example BE/.env
# BE/.env đã nằm trong .gitignore — khoá service account Firebase là quyền admin, không commit.

# ---- bắt buộc
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/selfstorage?retryWrites=true&w=majority
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- tuỳ chọn (bỏ dấu # để đổi; giá trị ghi sẵn là mặc định)
# PORT=4000
# CORS_ORIGINS=http://localhost:3000        # nhiều origin cách nhau bằng dấu phẩy — thêm domain Webapp đã deploy,
#                                           # và http://localhost:8081 nếu debug Mobile trên trình duyệt (expo start → phím w)
# SEED_PASSWORD=doi-mat-khau-cua-ban        # mật khẩu các tài khoản demo do `npm run seed` tạo (>= 8 ký tự); không đặt = dùng mặc định trong src/shared/config/env.ts
# FIREBASE_WEB_API_KEY=                     # có thì trang /api có ô đăng nhập lấy token
# NODE_ENV=development                      # deploy (Render) đặt NODE_ENV=production — render.yaml đã đặt sẵn; lệnh chạy vẫn `npm run start`
# AUTH_DEV_BYPASS=false                     # chỉ để dev: nhận header x-dev-user. Chỉ có hiệu lực khi KHÔNG production VÀ MONGODB_URI
#                                           # trỏ mongod cục bộ (localhost / 127.0.0.1) — ngoài ra bị bỏ qua kèm cảnh báo
# MOCK_PAYMENTS=true                        # thanh toán online của khách là GIẢ LẬP (bản demo). false → khách trả online nhận 501
#                                           # GATEWAY_NOT_CONFIGURED (thu tại quầy không đổi)
# SEED_CONFIRM=yes                          # chỉ cần khi chạy `npm run seed` với NODE_ENV=production (seed XOÁ SẠCH database)

# ---- gửi email hợp đồng PDF cho khách (tuỳ chọn — bỏ trống vẫn chạy, chỉ không gửi được email; khách vẫn tải được PDF)
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (https://myaccount.google.com/apppasswords) — KHÔNG dùng mật khẩu Gmail thường.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=ten-ban@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx                # mật khẩu ứng dụng 16 ký tự, không dấu cách
# MAIL_FROM="KhoAn <ten-ban@gmail.com>"     # bỏ trống = KhoAn <SMTP_USER>
# MAIL_BLOCKED_DOMAINS=khoan.dev            # không bao giờ gửi thư tới các tên miền này (tài khoản demo); "none" = tắt chặn
# Host chặn cổng SMTP (Render Free, Railway Free/Hobby: log báo "Connection timeout"/ENETUNREACH)? Dùng relay HTTPS thay SMTP:
# triển khai src/shared/mail/gmail-relay.gs trên script.google.com (hướng dẫn trong file) rồi điền 2 biến này.
# Có hai biến này thì ưu tiên dùng relay, các biến SMTP_* bên trên không cần nữa.
# MAIL_RELAY_URL=https://script.google.com/macros/s/xxxxxxxx/exec
# MAIL_RELAY_SECRET=chuoi-ngau-nhien-dai-trung-voi-SECRET-trong-script
# Khoá mã hoá mật khẩu mở kho (AES-GCM) để khách xem lại mật khẩu trong app + ký link tải biên lai.
# BẮT BUỘC khi NODE_ENV=production (thiếu → BE dừng lúc khởi động) — thêm trên Render: Service → Environment. Chuỗi ngẫu nhiên >= 16 ký tự,
# VD `openssl rand -hex 32`. Máy dev bỏ trống = tự suy từ FIREBASE_PRIVATE_KEY. Mật khẩu đã mã hoá bằng khoá cũ (suy từ
# FIREBASE_PRIVATE_KEY) vẫn đọc được sau khi đặt biến này; đặt rồi thì không đổi nữa.
# ACCESS_CODE_SECRET=
