# Sao chép thành Mobile/React-Native/.env rồi điền giá trị thật:  cp Mobile/React-Native/.env.example Mobile/React-Native/.env
# Dùng chung bộ khoá Firebase với Webapp (Firebase Console → Project settings → General → Your apps → Web app).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# tuỳ chọn
# EXPO_PUBLIC_API_URL=    # bỏ trống → app tự suy ra từ địa chỉ máy đang chạy Metro (điện thoại và máy tính cùng Wi-Fi)
# EXPO_PUBLIC_WEB_URL=    # trang Điều khoản / Bảo mật mà app mở ra
